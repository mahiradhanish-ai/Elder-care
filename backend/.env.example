# ElderCare Connect Backend Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/eldercare_connect?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_SECRET=eldercare_jwt_secure_super_secret_key_2026_dev
JWT_EXPIRE=7d

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# Application Timezone (IST - Asia/Kolkata)
TIMEZONE=Asia/Kolkata

# SMTP Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="ElderCare Connect" <no-reply@eldercareconnect.com>
